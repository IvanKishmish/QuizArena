<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
      <!-- reflection/DI-resolution baseline -->
      <PackageReference Include="MediatR" Version="12.5.0" />
      <!-- source-generated, no mediator indirection -->
      <PackageReference Include="Immediate.Handlers" Version="3.8.1" />
      <!--
        Mediator.SourceGenerator НЕ підключаємо тут навмисно: він уже є в
        QuizArena.Application (для продакшн-хендлерів), і два генератори в
        ланцюжку залежностей дають два однойменні AddMediator() -> "Ambiguous
        invocation". Mediator-варіант хендлера для H1 живе в Application
        (Benchmarking/H1/SubmitAnswerViaMediator.cs) саме через це.
        Абстракції Mediator (IMediator, ICommand<T> тощо) приходять сюди
        транзитивно через ProjectReference на Application нижче.
      -->
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\backend\QuizArena.Application\QuizArena.Application.csproj" />
    </ItemGroup>

</Project>
