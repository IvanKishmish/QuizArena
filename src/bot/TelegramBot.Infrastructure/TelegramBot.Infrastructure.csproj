<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TelegramBot.Infrastructure</RootNamespace>
  </PropertyGroup>

  <!--
    All Microsoft.EntityFrameworkCore* / Microsoft.AspNetCore.DataProtection* /
    Microsoft.Extensions.* packages are pinned to the SAME version on purpose.
    They form one dependency graph, and NuGet treats mismatched versions between them
    as a "package downgrade" and fails the restore (NU1605) once any transitive package
    (e.g. StackExchange.Redis -> Microsoft.Extensions.Logging.Abstractions, or
    Microsoft.AspNetCore.DataProtection.EntityFrameworkCore -> Microsoft.EntityFrameworkCore)
    pulls in a newer patch than what's pinned here. If you bump one, bump the shared
    property below to match, then `dotnet restore` and let it tell you if anything else drifted.
  -->
  <PropertyGroup>
    <EfCoreAndAspNetVersion>10.0.10</EfCoreAndAspNetVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TelegramBot.Application\TelegramBot.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Persistence: same PostgreSQL instance style as the main backend -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreAndAspNetVersion)" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />

    <!-- Token/session state cache + FSM state (Redis, same instance the backend already runs) -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.24" />

    <!-- Encrypting tokens at rest. The EntityFrameworkCore variant persists DataProtection's
         signing/encryption keys into BotDbContext (see BotDbContext : IDataProtectionKeyContext)
         instead of the local filesystem, so key material survives container restarts/redeploys. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="$(EfCoreAndAspNetVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="$(EfCoreAndAspNetVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(EfCoreAndAspNetVersion)" />

    <!-- Resilience for calls to the QuizArena API -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="$(EfCoreAndAspNetVersion)" />
    <PackageReference Include="Polly" Version="8.5.0" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />

    <!-- SignalR client to /hubs/game -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="$(EfCoreAndAspNetVersion)" />

    <PackageReference Include="Telegram.Bot" Version="22.5.0" />

    <!-- Design-time only: lets `dotnet ef` create BotDbContext via
         BotDbContextDesignTimeFactory without booting the Telegram.Bot host. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreAndAspNetVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="$(EfCoreAndAspNetVersion)" />

    <!-- NOTE: no explicit System.Text.Json reference — it ships inside the shared
         framework on net10.0 and NuGet will warn (NU1510) that an explicit reference
         is redundant/prunable. Removed on purpose. -->
  </ItemGroup>

</Project>
