<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TelegramBot.Bot</RootNamespace>
    <UserSecretsId>telegrambot-quizarena</UserSecretsId>
  </PropertyGroup>

  <!-- Must match TelegramBot.Infrastructure.csproj's EfCoreAndAspNetVersion exactly, or
       NuGet reports a package downgrade (NU1605) the moment this project references
       anything from that same dependency graph — which is exactly what happened when
       Microsoft.EntityFrameworkCore.Design was added here unpinned. -->
  <PropertyGroup>
    <EfCoreAndAspNetVersion>10.0.10</EfCoreAndAspNetVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TelegramBot.Application\TelegramBot.Application.csproj" />
    <ProjectReference Include="..\TelegramBot.Infrastructure\TelegramBot.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Telegram.Bot" Version="22.5.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />

    <!-- Required by `dotnet ef` tooling to be present on the STARTUP project specifically
         (separate requirement from BotDbContextDesignTimeFactory living in Infrastructure —
         see the error "startup project doesn't reference Microsoft.EntityFrameworkCore.Design"). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreAndAspNetVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Loads the same .env the docker-compose file reads, so `dotnet run` locally (outside
         Docker) picks up the exact same ConnectionStrings__*/Telegram__*/QuizArenaApi__*
         values with zero duplication — no secrets live in any appsettings*.json (see
         Program.cs: DotNetEnv.Env.Load only ever fills gaps, never overrides a variable
         that's already set — e.g. by docker-compose's own `environment:`/`env_file:`). -->
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
  </ItemGroup>

  <!-- Intentionally no explicit <Content Include="appsettings*.json"> here — the Web SDK
       already glob-includes appsettings.json / appsettings.{Environment}.json from the
       project directory by default. Re-declaring them caused NETSDK1022 (duplicate Content
       items). appsettings.json itself only holds non-secret static config (Logging,
       RateLimiting) — every connection string, token, and per-environment URL comes from
       .env / real environment variables, never from a committed file. -->

</Project>
